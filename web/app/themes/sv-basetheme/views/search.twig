{% extends 'base.twig' %}

{% block content %}
	<section class="container py-16">
		<h1 class="mb-6 text-4xl font-bold md:text-6xl">{{ title }}</h1>

		<div class="mb-10 max-w-xl">
			{{ function('get_search_form', { echo: false }) }}
		</div>

		{% if posts|length %}
			<ul class="flex flex-col gap-6">
				{% for post in posts %}
					<li>
						<a class="text-xl font-bold hover:text-primary" href="{{ post.link }}">{{ post.title }}</a>
						<p class="text-muted">{{ post.excerpt({ words: 30, read_more: false }) }}</p>
					</li>
				{% endfor %}
			</ul>

			{% include 'partials/pagination.twig' with { pagination: posts.pagination } %}
		{% else %}
			<p class="text-muted">{{ __('Niets gevonden. Probeer een ander woord.', 'sv-basetheme') }}</p>
		{% endif %}
	</section>
{% endblock %}
