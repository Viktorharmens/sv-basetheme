{
  "name": "studiovuurkever/sv-basetheme",
  "type": "project",
  "license": "MIT",
  "description": "Studio Vuurkever basetheme: Bedrock, Timber, ACF Pro en StoutLogic ACF Builder",
  "homepage": "https://www.studiovuurkever.nl",
  "keywords": [
    "bedrock",
    "wordpress",
    "timber",
    "acf"
  ],
  "repositories": [
    {
      "name": "wp-packages",
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "name": "acf",
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    }
  ],
  "require": {
    "php": ">=8.4",
    "composer/installers": "^2.0",
    "oscarotero/env": "^2.0",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "7.1.4",
    "roots/wp-config": "^1.0",
    "stoutlogic/acf-builder": "^1.12",
    "timber/timber": "^2.5",
    "vlucas/phpdotenv": "^5.0",
    "wp-plugin/wordpress-seo": "^28.8",
    "wpengine/advanced-custom-fields-pro": "^6.8"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "pestphp/pest": "^4.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "composer/installers": true,
      "roots/wordpress-core-installer": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.4.1"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "test": "pest"
  },
  "autoload": {
    "psr-4": {
      "SV\\Theme\\": "web/app/themes/sv-basetheme/src/"
    }
  }
}
